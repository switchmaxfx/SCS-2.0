<Window x:Class="SCS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SCS.UI"
        Title="S.C.S  Stratagem Control System"
        Width="1080" Height="640" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/icon.ico"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="StatusLedGlow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.9" Duration="0:0:0.9"/>
        </Storyboard>

        <!-- Slot card -->
        <DataTemplate x:Key="SlotTemplate" DataType="{x:Type ui:SlotViewModel}">
            <Border x:Name="Card" Margin="6" CornerRadius="10" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="196">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="CHANGE STRATAGEM" Click="SlotMenuChange_Click" Tag="{Binding}"/>
                        <MenuItem Header="CLEAR HOTKEY" Click="SlotMenuClearKey_Click" Tag="{Binding}"/>
                        <MenuItem Header="CLEAR SLOT" Click="SlotMenuClear_Click" Tag="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <!-- top accent line -->
                    <Border x:Name="TopLine" Height="2" VerticalAlignment="Top" Margin="18,0" CornerRadius="1"
                            Background="{StaticResource AccentLineBrush}" Opacity="0"/>
                    <Grid Margin="12,10,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="{Binding Number}" Style="{StaticResource Caption}" Foreground="{StaticResource TextFaintBrush}"/>
                            <TextBlock x:Name="Cat" Text="{Binding Category}" Style="{StaticResource Caption}" FontSize="9.5"
                                       HorizontalAlignment="Right" Foreground="{StaticResource TextDimBrush}"/>
                        </DockPanel>

                        <Button Grid.Row="1" Click="SlotPick_Click" Tag="{Binding}" Margin="0,6,0,8" Cursor="Hand"
                                ToolTip="Choose stratagem">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Hit" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- stratagem icon; frame stays visible if a stratagem has no icon -->
                                    <Border x:Name="IconFrame" Width="42" Height="42" CornerRadius="6" Margin="0,0,10,0"
                                            VerticalAlignment="Center" BorderThickness="1"
                                            BorderBrush="{StaticResource BorderHiBrush}" Background="{StaticResource InputBrush}">
                                        <Image Source="{Binding Icon}" Margin="-1" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="13"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="52" LineHeight="17"/>
                                </Grid>
                                <ui:ArrowStrip x:Name="Arrows" Grid.Row="1" Code="{Binding Code}" GlyphSize="11"
                                               Fill="{StaticResource AccentDimBrush}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </Grid>
                        </Button>

                        <ui:HotkeyBox Grid.Row="2" Hotkey="{Binding Hotkey, Mode=TwoWay}" IsConflict="{Binding IsConflict}"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                    <Setter TargetName="IconFrame" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NameText" Property="FontSize" Value="11"/>
                    <Setter TargetName="NameText" Property="FontFamily" Value="{StaticResource MonoFont}"/>
                    <Setter TargetName="Cat" Property="Foreground" Value="{StaticResource TextFaintBrush}"/>
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource Bg2Brush}"/>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderHiBrush}"/>
                    <Setter TargetName="TopLine" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Arrows" Property="Fill" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Card" Property="Effect" Value="{StaticResource AccentGlow}"/>
                    <Setter TargetName="TopLine" Property="Opacity" Value="1"/>
                    <Setter TargetName="Arrows" Property="Fill" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="IconFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid Background="{StaticResource Bg2Brush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- app icon with a soft cyan glow to match the visor -->
                    <Image Source="pack://application:,,,/Assets/icon64.png" Width="26" Height="26" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#2FD8FF" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="S.C.S" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="STRATAGEM CONTROL SYSTEM" Style="{StaticResource Caption}" Margin="12,1,0,0"
                               VerticalAlignment="Center"/>
                    <Border Margin="12,0,0,0" Padding="6,1" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{StaticResource BorderHiBrush}" VerticalAlignment="Center">
                        <TextBlock Text="v2.0" Style="{StaticResource Caption}" FontSize="9.5"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button Style="{StaticResource ChromeCloseButton}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Toolbar ================= -->
            <Grid Grid.Row="1" Margin="18,16,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" x:Name="ProfileBar">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                            <TextBlock Text="PROFILE" Style="{StaticResource Caption}" FontSize="9.5"/>
                            <TextBlock x:Name="ModifiedText" Text="MODIFIED" Style="{StaticResource Caption}" FontSize="9.5"
                                       Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <Grid>
                            <ComboBox x:Name="ProfileCombo" Width="230" SelectionChanged="ProfileCombo_SelectionChanged"/>
                            <TextBlock x:Name="UnsavedHint" Text="Unsaved profile" IsHitTestVisible="False" Margin="12,0,0,0"
                                       VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextFaintBrush}"/>
                        </Grid>
                    </StackPanel>
                    <Button Content="NEW" Margin="0,17,6,0" Click="New_Click" ToolTip="Start a blank profile"/>
                    <Button Content="SAVE" Margin="0,17,6,0" Click="Save_Click" ToolTip="Save (Ctrl+S)"/>
                    <Button Content="SAVE AS" Margin="0,17,6,0" Click="SaveAs_Click"/>
                    <Button Content="DELETE" Margin="0,17,6,0" Click="Delete_Click" Style="{StaticResource DangerButton}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="OverlayButton" Content="OVERLAY" Margin="0,17,6,0" Click="Overlay_Click"
                            ToolTip="In-game hotkey list (borderless / windowed mode)"/>
                    <Button x:Name="LedButton" Content="LED" Margin="0,17,6,0" Click="Led_Click" ToolTip="Small armed / disarmed indicator"/>
                    <Button x:Name="SettingsButton" Content="SETTINGS" Margin="0,17,6,0" Click="Settings_Click"/>
                    <Button x:Name="HelpButton" Content="HELP" Margin="0,17,14,0" Click="Help_Click"/>
                    <Button x:Name="ArmButton" Width="150" Height="38" Margin="0,17,0,0" Click="Arm_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ArmDot" Width="8" Height="8" Margin="0,0,10,0" Fill="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ArmText" Text="ARM" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Slots ================= -->
            <ItemsControl x:Name="SlotsList" Grid.Row="2" Margin="12,4,12,8" ItemTemplate="{StaticResource SlotTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" Rows="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ================= Status bar ================= -->
            <Border Grid.Row="3" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusLedGlow" Width="14" Height="14" Fill="{StaticResource AccentBrush}" Opacity="0"
                                 Effect="{StaticResource AccentGlow}"/>
                        <Ellipse x:Name="StatusLed" Width="9" Height="9" Fill="#5A1A20"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="STANDBY" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock x:Name="StatusDetail" Text="" Style="{StaticResource Caption}" Margin="14,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LAST" Style="{StaticResource Caption}" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock x:Name="LastText" Text="--" Style="{StaticResource Caption}" Margin="6,0,18,0"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="JITTER" Style="{StaticResource Caption}" Foreground="{StaticResource TextFaintBrush}"
                                   ToolTip="Worst deviation from the target timing during the last execution"/>
                        <TextBlock x:Name="JitterText" Text="--" Style="{StaticResource Caption}" Margin="6,0,18,0"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="SENT" Style="{StaticResource Caption}" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock x:Name="CountText" Text="0" Style="{StaticResource Caption}" Margin="6,0,18,0"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="TimingText" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource InfoBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
